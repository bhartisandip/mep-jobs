# Set this in the Hostinger Docker Manager project environment, never in git.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-64-hex-characters

# Optional overrides (defaults shown in docker-compose.yml / service/src/config.js)
# EXPIRY_DAYS=7
# LINKEDIN_DELAY_MS=4000
# MAX_PAGES_PER_SEARCH=3
# RATE_LIMIT_PER_MIN=60
